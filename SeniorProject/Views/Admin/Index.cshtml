@model List<SeniorProject.Models.UserRolesViewModel>
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <h2>User Management</h2>
    <table class="table table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td>
                        <a asp-action="ManageRoles" asp-route-userId="@user.UserId"
                           class="btn btn-sm btn-primary">Manage Roles</a>
                        <form asp-action="DeleteUser" method="post" style="display:inline">
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Delete this user?')">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>