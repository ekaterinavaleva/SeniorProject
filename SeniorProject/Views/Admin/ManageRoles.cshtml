@model List<SeniorProject.Models.ManageUserRolesViewModel>
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container mt-4">
    <h2>Manage Roles for @ViewBag.UserEmail</h2>
    <form asp-action="ManageRoles" asp-route-userId="@ViewBag.UserId" method="post">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="form-check">
                <input type="hidden" name="[@i].RoleName" value="@Model[i].RoleName" />
                <input type="hidden" name="[@i].RoleId" value="@Model[i].RoleId" />
                <input type="checkbox" name="[@i].Selected" value="true"
                       class="form-check-input"
                       @(Model[i].Selected ? "checked" : "") />
                <label class="form-check-label">@Model[i].RoleName</label>
            </div>
        }
        <button type="submit" class="btn btn-success mt-3">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
