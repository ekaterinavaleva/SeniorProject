@model List<SeniorProject.Models.ManageUserRolesViewModel>
@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container mt-4">
    <h2>Manage Roles for @ViewBag.UserEmail</h2>
    <form asp-action="ManageRoles" asp-route-userId="@ViewBag.UserId" method="post">
        @foreach (var role in Model)
        {
            <div class="form-check">
                <input type="checkbox" name="model[@Model.IndexOf(role)].Selected"
                       class="form-check-input"
                       @(role.Selected ? "checked" : "") />
                <input type="hidden" name="model[@Model.IndexOf(role)].RoleName"
                       value="@role.RoleName" />
                <input type="hidden" name="model[@Model.IndexOf(role)].RoleId"
                       value="@role.RoleId" />
                <label class="form-check-label">@role.RoleName</label>
            </div>
        }
        <button type="submit" class="btn btn-success mt-3">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
