@model List<SeniorProject.Models.SavedBasket>
@{
    ViewData["Title"] = "My Saved Baskets";
}

<div class="container mt-4">
    <h2 class="mb-4">My Saved Baskets</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You haven't saved any baskets yet! Go to the <a href="/Basket">Compare</a> page to find the best deals and save your receipts.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var basket in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-primary">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@basket.WinningSupermarket</h5>
                            <div class="d-flex align-items-center gap-2">
                                <small>@basket.SavedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small>
                                <form method="post" action="/Basket/DeleteBasket" onsubmit="return confirm('Delete this saved basket?');" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="basketId" value="@basket.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-light ms-2" title="Delete basket" style="font-weight:bold; line-height:1; padding: 2px 7px; font-size: 1.1rem;">
                                        &times;
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-success mb-0">Total Saved Price: @basket.TotalPrice.ToString("C2")</h6>
                                <button class="btn btn-outline-primary btn-sm" onclick="viewPriceTrend(@basket.Id, '@basket.WinningSupermarket')">
                                    <i class="bi bi-graph-up"></i> View Price Trend
                                </button>
                            </div>
                            
                            <ul class="list-group list-group-flush">
                                @foreach (var item in basket.Items)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <div>
                                            <span class="badge bg-secondary rounded-pill me-2">@item.Quantity</span>
                                            @item.ProductName
                                        </div>
                                        <span>@item.UnitPrice.ToString("C2")</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="priceTrendModal" tabindex="-1" aria-labelledby="priceTrendModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="priceTrendModalLabel">Price Comparison</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body position-relative">
        <div id="chartLoading" class="text-center py-5" style="display:none;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading price data...</p>
        </div>
        <canvas id="priceTrendChart" style="max-height: 400px; display:none;"></canvas>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let priceChart = null;

        function viewPriceTrend(basketId, storeName) {
            const modal = new bootstrap.Modal(document.getElementById('priceTrendModal'));
            
            document.getElementById('chartLoading').style.display = 'block';
            document.getElementById('priceTrendChart').style.display = 'none';
            
            modal.show();

            fetch('/Basket/GetBasketPriceComparison?basketId=' + basketId)
                .then(function(response) {
                    return response.json();
                })
                .then(function(data) {
                    document.getElementById('chartLoading').style.display = 'none';
                    document.getElementById('priceTrendChart').style.display = 'block';

                    const ctx = document.getElementById('priceTrendChart').getContext('2d');
                    
                    if (priceChart) {
                        priceChart.destroy();
                    }

                    let savedPriceColor = '';
                    let currentPriceColor = '';
                    const terracotta = '#C1440E';
                    const forestGreen = '#4A7C59';
                    const warmGray = '#B4AFA8';

                    if (data.totalSavedPrice > data.totalCurrentPrice) {
                        savedPriceColor = terracotta;   
                        currentPriceColor = forestGreen; 
                    } else if (data.totalSavedPrice < data.totalCurrentPrice) {
                        savedPriceColor = forestGreen;    
                        currentPriceColor = terracotta; 
                    } else {
                        savedPriceColor = warmGray;
                        currentPriceColor = warmGray;
                    }

                    priceChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: ['Price on ' + data.savedDate, 'Current Price'],
                            datasets: [
                                {
                                    label: 'Total Basket Price at ' + storeName,
                                    data: [data.totalSavedPrice, data.totalCurrentPrice],
                                    backgroundColor: 'rgba(180, 175, 168, 0.2)',
                                    borderColor: warmGray,
                                    borderWidth: 2,
                                    pointBackgroundColor: [savedPriceColor, currentPriceColor],
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 2,
                                    pointRadius: 6,
                                    pointHoverRadius: 8,
                                    fill: true,
                                    tension: 0.1
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: false, 
                                    title: {
                                        display: true,
                                        text: 'Total Price (€)'
                                    }
                                }
                            },
                            plugins: {
                                legend: {
                                    onClick: function(e) {
                                        e.stopPropagation(); 
                                    }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            let label = context.dataset.label || '';
                                            if (label) {
                                                label += ': ';
                                            }
                                            if (context.parsed.y !== null) {
                                                label += '€' + context.parsed.y.toFixed(2);
                                            }
                                            return label;
                                        }
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(function(err) {
                    console.error('Error fetching price trend:', err);
                    document.getElementById('chartLoading').style.display = 'none';
                    alert("Could not load price comparison.");
                });
        }
    </script>
}
