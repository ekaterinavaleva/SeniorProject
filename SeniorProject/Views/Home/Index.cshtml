@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Home Page";
}

@if (User.IsInRole("Admin") || User.IsInRole("RetailManager"))
{
    <div class="alert alert-info mt-4">
        <h3>Manager Tools</h3>
        <a class="btn btn-primary" asp-controller="RetailManager" asp-action="Upload">Go to Upload Portal</a>
        <a class="btn btn-secondary" asp-controller="RetailManagerMapping" asp-action="Index">Open Product Mapping Tool</a>
    </div>
}

<section class="text-center py-5">
    <h1 class="display-4 brand-font" style="color: var(--basket-primary);">EuroSmetka</h1>
    <p class="lead text-muted-warm" style="font-size: 1.25rem;">A price monitoring tool for grocery products across major retail chains in Bulgaria.</p>
    <p class="mt-3 text-secondary" style="font-size: 1.1rem; line-height: 1.6;">EuroSmetka aggregates and analyzes daily product price data published on <a href="https://kolkostruva.bg" target="_blank" class="text-decoration-none border-bottom border-primary fw-medium">kolkostruva.bg</a> - the official price monitoring portal maintained by the Bulgarian Consumer Protection Commission (КЗП) under the Law on the Introduction of the Euro in the Republic of Bulgaria. The platform enables consumers to compare individual product prices across retail chains operating in Sofia, Plovdiv, Varna, Burgas, and Blagoevgrad.</p>
</section>

<section class="mb-5 py-5 bg-light rounded-4 shadow-sm px-4 border">
    <h2 class="brand-font text-center mb-5 text-dark">How it works</h2>
    <div class="row text-center g-5">
        <div class="col-md-4">
            <div class="h1 mb-4 text-primary"><i class="bi bi-tags"></i></div>
            <h4 class="brand-font fw-bold text-dark">1. Browse Promotions</h4>
            <p class="text-muted" style="font-size: 1.05rem;">View products currently offered at a promotional price across all tracked retail chains, sorted by discount.</p>
        </div>
        <div class="col-md-4">
            <div class="h1 mb-4 text-success"><i class="bi bi-search"></i></div>
            <h4 class="brand-font fw-bold text-dark">2. Search Products</h4>
            <p class="text-muted" style="font-size: 1.05rem;">Look up a specific product by name and compare its current price across stores in your city.</p>
        </div>
        <div class="col-md-4">
            <div class="h1 mb-4 text-warning"><i class="bi bi-basket"></i></div>
            <h4 class="brand-font fw-bold text-dark">3. Compare Baskets</h4>
            <p class="text-muted" style="font-size: 1.05rem;">Select a set of essential products and see which store offers the lowest total price for your basket.</p>
        </div>
    </div>
</section>
